#!/bin/sh
# Record a fixed-length macOS proof video with the built-in screencapture tool.

set -eu

SCREENCAPTURE=/usr/sbin/screencapture
DURATION=30
OUTPUT="${HOME}/Desktop/meringue-proof-$(date +%Y%m%d-%H%M%S).mov"
DISPLAY_NUMBER=1
INCLUDE_CURSOR=0
SHOW_CLICKS=0
INCLUDE_MICROPHONE=0

usage() {
  cat <<'EOF'
Usage: bin/meringue-record [options]

Options:
  --duration SECONDS  Recording length (default: 30)
  --display NUMBER    Record one display (default: 1)
  --output PATH       Output .mov path (default: ~/Desktop/meringue-proof-*.mov)
  --cursor            Include the pointer
  --show-clicks       Show click indicators
  --microphone        Include macOS's default microphone input
  -h, --help          Show this help
EOF
}

fail() {
  printf 'meringue-record: %s\n' "$1" >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --duration)
      [ "$#" -ge 2 ] || fail "--duration needs a value"
      DURATION=$2
      shift 2
      ;;
    --display)
      [ "$#" -ge 2 ] || fail "--display needs a value"
      DISPLAY_NUMBER=$2
      shift 2
      ;;
    --output)
      [ "$#" -ge 2 ] || fail "--output needs a value"
      OUTPUT=$2
      shift 2
      ;;
    --cursor)
      INCLUDE_CURSOR=1
      shift
      ;;
    --show-clicks)
      SHOW_CLICKS=1
      shift
      ;;
    --microphone)
      INCLUDE_MICROPHONE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "unknown option: $1"
      ;;
  esac
done

[ "$(uname -s)" = "Darwin" ] || fail "this helper requires macOS"
[ -x "$SCREENCAPTURE" ] || fail "macOS screencapture was not found at $SCREENCAPTURE"

case "$DURATION" in
  ''|*[!0-9]*) fail "duration must be a positive integer" ;;
esac
[ "$DURATION" -gt 0 ] || fail "duration must be a positive integer"

if [ -n "$DISPLAY_NUMBER" ]; then
  case "$DISPLAY_NUMBER" in
    ''|*[!0-9]*) fail "display must be a positive integer" ;;
  esac
  [ "$DISPLAY_NUMBER" -gt 0 ] || fail "display must be a positive integer"
fi

case "$OUTPUT" in
  '') fail "output must not be empty" ;;
  -*) fail "output cannot start with '-'" ;;
esac

if [ -e "$OUTPUT" ]; then
  fail "output already exists: $OUTPUT"
fi

mkdir -p "$(dirname "$OUTPUT")"

set -- -v -V "$DURATION" -x
[ -n "$DISPLAY_NUMBER" ] && set -- "$@" "-D$DISPLAY_NUMBER"
[ "$INCLUDE_CURSOR" -eq 1 ] && set -- "$@" -C
[ "$SHOW_CLICKS" -eq 1 ] && set -- "$@" -k
[ "$INCLUDE_MICROPHONE" -eq 1 ] && set -- "$@" -g

printf 'Recording %ss to %s\n' "$DURATION" "$OUTPUT"
exec "$SCREENCAPTURE" "$@" "$OUTPUT"
